# Student AI Assistant - Environment Configuration
# Copy this file to .env and fill in your values

# Flask Configuration
SECRET_KEY=change-this-to-a-random-secret-key
DATABASE_URL=sqlite:///student_assistant.db

# AI Configuration (required for AI features)
# Use OpenRouter as provider (supports OpenAI-format keys)
AI_PROVIDER=openai
AI_API_KEY=your-openai-api-key-here
AI_MODEL=gpt-4o-mini
# For OpenRouter keys, set the base URL (required for sk-or-v1-... keys):
AI_BASE_URL=https://openrouter.ai/api/v1
# For native OpenAI keys, leave AI_BASE_URL empty or unset

# Email Configuration (optional - app works without it)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=true
MAIL_FROM=noreply@studentassistant.com

# Application Configuration
DEBUG=false
